{
  "mcpServers": {
    "moz": {
      "type": "http",
      "url": "https://mcp-dev.moz.tools/mcp",
      "directTools": [
        "get_bugzilla_bug",
        "get_phabricator_revision"
      ],
      "exposure": "direct"
    },
    "firefox-devtools": {
      "type": "stdio",
      "command": "${MACH_PYTHON:-python3}",
      "args": [
        "mach",
        "--quiet",
        "firefox-devtools-mcp",
        "--pref",
        "remote.prefs.recommended=false",
        "--pref",
        "browser.smartwindow.enabled=true",
        "--enable-privileged-context",
        "--enable-script"
      ],
      "enabled": false
    }
  }
}
